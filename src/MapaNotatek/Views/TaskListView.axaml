<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MapaNotatek.Views.TaskListView"
             Focusable="True"
             AutomationProperties.Name="Otwarte zadania">
    <Grid RowDefinitions="Auto,*"
          Background="{DynamicResource WorkspaceBackgroundBrush}">
        <Border Grid.Row="0"
                Padding="24,20,24,16"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Otwarte zadania" Classes="heading" />
                    <TextBlock Text="Przeciągnij kafelek, aby ustawić najważniejsze zadania u góry."
                               Classes="subtitle"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceMutedBrush}"
                        CornerRadius="{DynamicResource CornerRadiusSmall}"
                        Padding="10,5">
                    <TextBlock x:Name="TasksCountText"
                               Classes="metadata"
                               AutomationProperties.LiveSetting="Polite" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ListBox x:Name="TasksList"
                     Classes="library-list"
                     Margin="24,16,24,24"
                     DoubleTapped="OnItemDoubleTapped"
                     KeyDown="OnKeyDown"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Lista otwartych zadań"
                     AutomationProperties.HelpText="Przeciągaj zadania, aby zmieniać ich priorytet. Spacja kończy zadanie, a Enter otwiera jego źródło.">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="MinHeight" Value="44" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="ListBoxItem Border.task-card">
                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                    </Style>
                    <Style Selector="ListBoxItem:pointerover Border.task-card">
                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                    </Style>
                    <Style Selector="ListBoxItem:selected Border.task-card">
                        <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    </Style>
                    <Style Selector="ListBoxItem:focus-visible Border.task-card">
                        <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="task-card"
                                CornerRadius="{DynamicResource CornerRadiusMedium}"
                                Padding="16,14"
                                AutomationProperties.Name="{ReflectionBinding Text}"
                                AutomationProperties.HelpText="Spacja kończy zadanie. Enter otwiera jego źródło.">
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                                <Border Width="24"
                                        MinHeight="32"
                                        VerticalAlignment="Top"
                                        CornerRadius="4"
                                        Background="Transparent"
                                        Cursor="SizeAll"
                                        ToolTip.Tip="Przeciągnij, aby zmienić priorytet">
                                    <TextBlock Text="⋮⋮"
                                               FontSize="16"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <CheckBox Grid.Column="1"
                                          IsChecked="{ReflectionBinding Item.IsDone, Mode=OneWay}"
                                          IsCheckedChanged="OnTaskChecked"
                                          MinWidth="32"
                                          MinHeight="32"
                                          VerticalAlignment="Top"
                                          Margin="0,1,0,0"
                                          ToolTip.Tip="Oznacz zadanie jako ukończone"
                                          AutomationProperties.Name="{ReflectionBinding Text, StringFormat='Ukończ zadanie: {0}'}" />
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="{ReflectionBinding Text}"
                                               FontSize="15"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Źródło" Classes="eyebrow" />
                                        <TextBlock Text="{ReflectionBinding SourceTitle}"
                                                   Classes="metadata"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <TextBlock Text="OSOBY"
                                                   Classes="eyebrow"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Content="Wybierz osoby…"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                MinHeight="30"
                                                Padding="8,4"
                                                FontSize="12"
                                                Loaded="OnTaskPeopleButtonLoaded"
                                                Click="OnTaskPeopleClick" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyState"
                        IsVisible="False"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="360"
                        Spacing="8"
                        AutomationProperties.Name="Wszystko zrobione. Nie ma otwartych zadań w tym widoku.">
                <TextBlock Text="Wszystko zrobione"
                           HorizontalAlignment="Center"
                           FontSize="17"
                           FontWeight="SemiBold" />
                <TextBlock Text="Nie ma obecnie żadnych otwartych zadań w tym widoku."
                           Classes="subtitle"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
