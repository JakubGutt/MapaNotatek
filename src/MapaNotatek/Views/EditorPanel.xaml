<UserControl
    x:Class="MapaNotatek.Views.EditorPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="12" Spacing="8">
            <StackPanel x:Name="EmptyPanel">
                <TextBlock Text="Wybierz projekt lub notatkę." Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel x:Name="ProjectPanel" Visibility="Collapsed" Spacing="8">
                <TextBlock Text="Projekt" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBox x:Name="ProjectNameBox" Header="Nazwa" PlaceholderText="Nazwa projektu" TextChanged="OnProjectChanged" />
                <TextBox
                    x:Name="ProjectDescriptionBox"
                    Header="Opis"
                    PlaceholderText="Krótki opis"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="80"
                    TextChanged="OnProjectChanged" />
                <TextBlock Text="Checklista projektu" FontWeight="SemiBold" />
                <StackPanel x:Name="ProjectChecklistHost" Spacing="4" />
                <Button Content="Dodaj zadanie" Click="OnAddProjectTask" ToolTipService.ToolTip="Dodaj zadanie do checklisty projektu" />
                <TextBlock Text="Powiązane notatki" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ListView x:Name="RelatedNotesList" IsItemClickEnabled="True" ItemClick="OnRelatedNoteClick" MaxHeight="180" />
                <TextBlock Text="Otwarte zadania z notatek" FontWeight="SemiBold" Margin="0,8,0,0" />
                <StackPanel x:Name="ProjectOpenTasksHost" Spacing="4" />
                <Button Content="Archiwizuj / przywróć" Click="OnArchiveProject" ToolTipService.ToolTip="Archiwizuj lub przywróć projekt" />
            </StackPanel>

            <StackPanel x:Name="NotePanel" Visibility="Collapsed" Spacing="8">
                <TextBlock Text="Notatka" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBox x:Name="NoteTitleBox" Header="Tytuł" PlaceholderText="Tytuł notatki" TextChanged="OnNoteChanged" />
                <TextBox
                    x:Name="NoteBodyBox"
                    Header="Treść"
                    PlaceholderText="Treść notatki"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="160"
                    TextChanged="OnNoteChanged" />
                <TextBox
                    x:Name="NoteTagsBox"
                    Header="Tagi"
                    PlaceholderText="projekt-a, klient-x"
                    TextChanged="OnNoteChanged" />
                <TextBlock x:Name="NoteDatesText" Opacity="0.7" TextWrapping="Wrap" />
                <TextBlock Text="Checklista" FontWeight="SemiBold" />
                <StackPanel x:Name="NoteChecklistHost" Spacing="4" />
                <Button Content="Dodaj zadanie" Click="OnAddNoteTask" ToolTipService.ToolTip="Dodaj zadanie do checklisty notatki" />
                <Button Content="Przenieś do kosza" Click="OnTrashNote" ToolTipService.ToolTip="Delete — przenieś notatkę do kosza" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
