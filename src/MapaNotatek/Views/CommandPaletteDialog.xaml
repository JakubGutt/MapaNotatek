<ContentDialog
    x:Class="MapaNotatek.Views.CommandPaletteDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Polecenia"
    PrimaryButtonText="Uruchom"
    CloseButtonText="Anuluj"
    DefaultButton="Primary">
    <StackPanel Spacing="8" Width="420">
        <TextBox x:Name="FilterBox" PlaceholderText="Filtruj polecenia…" TextChanged="OnFilterChanged" />
        <ListView x:Name="CommandsList" MaxHeight="360" DoubleTapped="OnDoubleTapped" />
    </StackPanel>
</ContentDialog>
