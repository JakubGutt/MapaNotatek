<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MapaNotatek.Views.EditorPanel">
    <UserControl.Styles>
        <Style Selector="Button.FormatButton">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.HeaderAction">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="TextBlock.MetaLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.62" />
        </Style>
        <Style Selector="Border.EditorCell">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BoxShadow" Value="0 3 12 0 #12000000" />
        </Style>
        <Style Selector="Border.EditorCell:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BoxShadow" Value="0 6 18 0 #1C000000" />
        </Style>
        <Style Selector="Button.CellAction">
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.AddCellButton">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.ProjectCard">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24" />
        </Style>
        <Style Selector="TextBlock.ProjectSectionTitle">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.ProjectCount">
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style Selector="ListBox.ProjectList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.ProjectList ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid x:Name="EmptyPanel">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="Wybierz notatkę lub element struktury"
                           FontSize="24"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Otwarty dokument pojawi się tutaj w pełnej przestrzeni roboczej."
                           Opacity="0.65"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ProjectPanel"
              IsVisible="False"
              RowDefinitions="Auto,*"
              Background="{DynamicResource WorkspaceBackgroundBrush}"
              SizeChanged="OnProjectPanelSizeChanged">
            <Border Grid.Row="0"
                    Padding="24,14"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    Background="{DynamicResource SurfaceBrush}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="ProjectKindLabel" Text="PROJEKT" Classes="eyebrow" />
                        <TextBlock x:Name="ProjectWorkspaceTitleText" Text="Przestrzeń szczegółów" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="ProjectHeaderContextText"
                                   Text="Opis, zadania i materiały w jednym miejscu"
                                   Classes="metadata" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Działania ▾"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Więcej działań dotyczących elementu">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Przenieś do kosza…" Click="OnDeleteProject" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid x:Name="ProjectWorkspaceGrid"
                      MaxWidth="1240"
                      HorizontalAlignment="Stretch"
                      Margin="28,24,28,32"
                      ColumnDefinitions="3*,2*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="18"
                      RowSpacing="18">
                    <Border x:Name="ProjectOverviewCard"
                            Grid.Row="0"
                            Grid.Column="0"
                            Classes="ProjectCard">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="ProjectOverviewLabel" Classes="MetaLabel" Text="O ELEMENCIE" />
                            <TextBox x:Name="ProjectNameBox"
                                     PlaceholderText="Nazwa elementu"
                                     FontSize="30"
                                     FontWeight="SemiBold"
                                     Padding="0,3,0,8"
                                     BorderThickness="0,0,0,1"
                                     Background="Transparent"
                                     TextChanged="OnProjectChanged" />
                            <TextBlock Classes="MetaLabel" Text="CEL I KONTEKST" Margin="0,4,0,0" />
                            <TextBox x:Name="ProjectDescriptionBox"
                                     PlaceholderText="Opisz rolę, zakres i najważniejsze informacje o tym elemencie…"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="170"
                                     VerticalContentAlignment="Top"
                                     TextChanged="OnProjectChanged" />
                            <TextBlock Classes="MetaLabel" Text="OSOBY" Margin="0,4,0,0" />
                            <Button x:Name="ProjectPeopleButton"
                                    Content="Wybierz osoby…"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="OnProjectPeopleClick" />
                            <TextBlock Text="Możesz wybrać kilka osób istniejących w panelu Osoby."
                                       Classes="metadata"
                                       TextWrapping="Wrap" />
                            <StackPanel x:Name="ProjectSystemsPanel" Spacing="5" IsVisible="False">
                                <TextBlock Classes="MetaLabel" Text="SYSTEMY" Margin="0,4,0,0" />
                                <Button x:Name="ProjectSystemsButton"
                                        Content="Wybierz systemy…"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Click="OnProjectSystemsClick" />
                                <TextBlock Text="Przypisania są jawne i niezależne — element może należeć do kilku systemów."
                                           Classes="metadata"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock x:Name="ProjectMetaText"
                                       Classes="metadata"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ProjectChecklistSection"
                            Grid.Row="1"
                            Grid.Column="0"
                            Classes="ProjectCard">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Plan działania" Classes="ProjectSectionTitle" />
                                    <TextBlock Text="Zadania należące bezpośrednio do projektu."
                                               Classes="metadata"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="+ Dodaj zadanie"
                                        VerticalAlignment="Center"
                                        Click="OnAddProjectTask" />
                            </Grid>
                            <Border Classes="ProjectCount" HorizontalAlignment="Left">
                                <TextBlock x:Name="ProjectChecklistCountText" Classes="metadata" />
                            </Border>
                            <TextBlock x:Name="ProjectChecklistEmptyText"
                                       Text="Nie ma jeszcze zadań projektu. Dodaj pierwszy konkretny krok."
                                       Classes="subtitle"
                                       TextWrapping="Wrap"
                                       IsVisible="False" />
                            <StackPanel x:Name="ProjectChecklistHost" Spacing="7" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ProjectNotesSection"
                            Grid.Row="0"
                            Grid.Column="1"
                            Classes="ProjectCard">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Powiązane notatki" Classes="ProjectSectionTitle" />
                                    <TextBlock Text="Materiały oznaczone tagiem projektu."
                                               Classes="metadata"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="1" Classes="ProjectCount" VerticalAlignment="Top">
                                    <TextBlock x:Name="ProjectNotesCountText" Classes="metadata" />
                                </Border>
                            </Grid>
                            <TextBlock x:Name="ProjectNotesEmptyText"
                                       Text="Brak powiązanych notatek. Dodaj tag projektu do notatki, aby pojawiła się tutaj."
                                       Classes="subtitle"
                                       TextWrapping="Wrap"
                                       IsVisible="False" />
                            <Button Content="+ Nowa notatka w projekcie"
                                    HorizontalAlignment="Left"
                                    Click="OnNewProjectNote" />
                            <ListBox x:Name="RelatedNotesList"
                                     Classes="ProjectList"
                                     MinHeight="120"
                                     MaxHeight="280"
                                     DoubleTapped="OnRelatedNoteDoubleTapped" />
                            <TextBlock x:Name="ProjectNotesHintText"
                                       Text="Kliknij dwukrotnie, aby otworzyć notatkę."
                                       Classes="metadata"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ProjectTasksSection"
                            Grid.Row="1"
                            Grid.Column="1"
                            Classes="ProjectCard">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Zadania z notatek" Classes="ProjectSectionTitle" />
                                    <TextBlock Text="Otwarte pozycje z całej dokumentacji projektu."
                                               Classes="metadata"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="1" Classes="ProjectCount" VerticalAlignment="Top">
                                    <TextBlock x:Name="ProjectTasksCountText" Classes="metadata" />
                                </Border>
                            </Grid>
                            <TextBlock x:Name="ProjectTasksEmptyText"
                                       Text="W powiązanych notatkach nie ma otwartych zadań."
                                       Classes="subtitle"
                                       TextWrapping="Wrap"
                                       IsVisible="False" />
                            <StackPanel x:Name="ProjectOpenTasksHost" Spacing="8" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="NotePanel" IsVisible="False" RowDefinitions="Auto,Auto,Auto,*,Auto">
            <Border Grid.Row="0"
                    Padding="18,10"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderSubtleBrush}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="NOTATKA" FontSize="10" FontWeight="SemiBold" Opacity="0.55" />
                        <TextBlock Text="Edytor komórkowy • lokalnie" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Classes="HeaderAction"
                                Content="Do Confluence"
                                ToolTip.Tip="Skopiuj treść jako bezpieczny rich text i zwykły tekst"
                                Click="OnCopyForConfluence" />
                        <Button Classes="HeaderAction"
                                Content="Historia"
                                ToolTip.Tip="Przeglądaj i przywracaj lokalne wersje dokumentu"
                                Click="OnShowHistory" />
                        <Button Classes="HeaderAction"
                                Content="Przypnij"
                                ToolTip.Tip="Przypnij lub odepnij notatkę"
                                Click="OnTogglePin" />
                        <Button x:Name="MetadataToggleButton"
                                Classes="HeaderAction"
                                Content="Ukryj szczegóły"
                                ToolTip.Tip="Pokaż lub ukryj prawy panel szczegółów notatki"
                                Click="OnToggleMetadata" />
                        <Button x:Name="FocusModeButton"
                                Classes="HeaderAction"
                                Content="Tryb skupienia"
                                ToolTip.Tip="Ukryj nawigację i szczegóły"
                                Click="OnToggleFocusMode" />
                        <Button x:Name="ExportMenuButton"
                                Classes="HeaderAction"
                                Content="Eksportuj ▾"
                                Click="OnExportMenuClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Padding="14,7"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    Background="{DynamicResource SurfaceMutedBrush}">
                <Grid ColumnDefinitions="*,Auto">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="FormatToolbar" Orientation="Horizontal" Spacing="3">
                            <ComboBox x:Name="EditorFontPicker"
                                      Width="120"
                                      MinHeight="32"
                                      SelectedIndex="0"
                                      ToolTip.Tip="Krój pisma edytora. Plik pozostaje przenośnym Markdownem."
                                      SelectionChanged="OnEditorFontChanged">
                                <ComboBoxItem Content="Inter" />
                                <ComboBoxItem Content="Szeryfowa" />
                                <ComboBoxItem Content="Monospace" />
                            </ComboBox>
                            <ComboBox x:Name="EditorFontSizePicker"
                                      Width="72"
                                      MinHeight="32"
                                      SelectedIndex="1"
                                      ToolTip.Tip="Rozmiar tekstu w edytorze"
                                      SelectionChanged="OnEditorFontSizeChanged">
                                <ComboBoxItem Content="14" />
                                <ComboBoxItem Content="16" />
                                <ComboBoxItem Content="18" />
                            </ComboBox>
                            <Border Width="1" Margin="5,4" Background="{DynamicResource BorderStrongBrush}" Opacity="0.35" />
                            <Button Classes="FormatButton" Content="B" FontWeight="Bold"
                                    ToolTip.Tip="Pogrub zaznaczony tekst (⌘/Ctrl+B)" Click="OnFormatBold" />
                            <Button Classes="FormatButton" Content="I" FontStyle="Italic"
                                    ToolTip.Tip="Zastosuj kursywę do zaznaczenia (⌘/Ctrl+I)" Click="OnFormatItalic" />
                            <Button Classes="FormatButton" Content="S̶"
                                    ToolTip.Tip="Przekreślenie" Click="OnFormatStrike" />
                            <Button Classes="FormatButton" Content="Kod"
                                    ToolTip.Tip="Kod w tekście" Click="OnFormatCode" />
                            <Border Width="1" Margin="5,4" Background="{DynamicResource BorderStrongBrush}" Opacity="0.35" />
                            <Button Classes="FormatButton" Content="H1" ToolTip.Tip="Nagłówek 1" Click="OnFormatH1" />
                            <Button Classes="FormatButton" Content="H2" ToolTip.Tip="Nagłówek 2" Click="OnFormatH2" />
                            <Button Classes="FormatButton" Content="H3" ToolTip.Tip="Nagłówek 3" Click="OnFormatH3" />
                            <Border Width="1" Margin="5,4" Background="{DynamicResource BorderStrongBrush}" Opacity="0.35" />
                            <Button Classes="FormatButton" Content="• Lista" ToolTip.Tip="Lista punktowana" Click="OnFormatBullet" />
                            <Button Classes="FormatButton" Content="1. Lista" ToolTip.Tip="Lista numerowana" Click="OnFormatNumbered" />
                            <Button Classes="FormatButton" Content="☐ Zadanie" ToolTip.Tip="Pozycja checklisty" Click="OnFormatCheck" />
                            <Button Classes="FormatButton" Content="Cytat" ToolTip.Tip="Cytat" Click="OnFormatQuote" />
                            <Border Width="1" Margin="5,4" Background="{DynamicResource BorderStrongBrush}" Opacity="0.35" />
                            <Button Classes="FormatButton" Content="Wikilink" ToolTip.Tip="Powiązanie [[Notatka]]" Click="OnFormatWiki" />
                            <Button Classes="FormatButton" Content="Link" ToolTip.Tip="Wstaw link" Click="OnFormatLink" />
                            <Button Classes="FormatButton" Content="Obraz" ToolTip.Tip="Skopiuj lokalny obraz do biblioteki" Click="OnInsertImage" />
                            <Button Classes="FormatButton" Content="Tabela" ToolTip.Tip="Wstaw edytowalną tabelę" Click="OnFormatTable" />
                            <Button Classes="FormatButton" Content="Linia" ToolTip.Tip="Separator" Click="OnFormatRule" />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="12,0,0,0">
                        <RadioButton x:Name="EditModeRadio"
                                     Content="Komórki"
                                     GroupName="NoteMode"
                                     IsChecked="True"
                                     IsCheckedChanged="OnNoteModeChanged"
                                     VerticalAlignment="Center" />
                        <RadioButton x:Name="PreviewModeRadio"
                                     Content="Podgląd"
                                     GroupName="NoteMode"
                                     IsCheckedChanged="OnNoteModeChanged"
                                     VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="FindPanel"
                    Grid.Row="2"
                    IsVisible="False"
                    Padding="14,8"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    Background="{DynamicResource SurfaceBrush}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <Grid MinWidth="900"
                          ColumnDefinitions="260,Auto,180,Auto,Auto,Auto,Auto,*,Auto"
                          ColumnSpacing="6">
                        <TextBox x:Name="FindTextBox"
                                 Grid.Column="0"
                                 PlaceholderText="Znajdź w dokumencie"
                                 TextChanged="OnFindTextChanged"
                                 KeyDown="OnFindKeyDown" />
                        <TextBlock x:Name="FindCountText"
                                   Grid.Column="1"
                                   MinWidth="62"
                                   VerticalAlignment="Center"
                                   Text="0 wyników"
                                   FontSize="11"
                                   Opacity="0.62" />
                        <TextBox x:Name="ReplaceTextBox"
                                 Grid.Column="2"
                                 PlaceholderText="Zamień na"
                                 KeyDown="OnReplaceKeyDown" />
                        <Button Grid.Column="3" Content="Poprzedni" Click="OnFindPrevious" />
                        <Button Grid.Column="4" Content="Następny" Click="OnFindNext" />
                        <Button Grid.Column="5" Content="Zamień" Click="OnReplaceCurrent" />
                        <Button Grid.Column="6" Content="Zamień wszystko" Click="OnReplaceAll" />
                        <CheckBox x:Name="FindCaseSensitiveBox"
                                  Grid.Column="7"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Content="Wielkość liter"
                                  IsCheckedChanged="OnFindOptionsChanged" />
                        <Button Grid.Column="8"
                                Content="Zamknij"
                                ToolTip.Tip="Zamknij wyszukiwanie (Esc)"
                                Click="OnCloseFind" />
                    </Grid>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ClipToBounds="True">
                <Border Grid.Column="0"
                        Padding="28,22"
                        ClipToBounds="True"
                        Background="{DynamicResource WorkspaceBackgroundBrush}">
                    <Border x:Name="DocumentPaper"
                            MaxWidth="920"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Padding="54,42"
                            CornerRadius="10"
                            Background="{DynamicResource SurfaceBrush}"
                            BoxShadow="0 8 28 0 #18000000">
                        <Grid RowDefinitions="Auto,*">
                            <TextBox x:Name="NoteTitleBox"
                                     Grid.Row="0"
                                     PlaceholderText="Tytuł notatki"
                                     FontSize="34"
                                     FontWeight="SemiBold"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0,0,0,18"
                                     TextChanged="OnNoteChanged" />

                            <TextBox x:Name="NoteBodyBox"
                                     Grid.Row="1"
                                     IsVisible="False"
                                     IsHitTestVisible="False"
                                     Focusable="False"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     TextWrapping="Wrap"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     FontSize="16"
                                     LineHeight="25"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0"
                                     TextChanged="OnNoteChanged" />

                            <ScrollViewer x:Name="VisualEditorScroll"
                                          Grid.Row="1"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="12">
                                    <StackPanel x:Name="VisualBlocksHost" Spacing="10" />
                                    <Border Padding="12,10"
                                            Margin="0,3,0,12"
                                            CornerRadius="10"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            Background="{DynamicResource SurfaceMutedBrush}">
                                        <StackPanel Spacing="7">
                                            <TextBlock Classes="MetaLabel" Text="DODAJ KOMÓRKĘ" />
                                            <WrapPanel Orientation="Horizontal">
                                                <Button Classes="AddCellButton" Content="+ Tekst" Margin="0,0,5,5" Click="OnAddParagraphBlock" />
                                                <Button Classes="AddCellButton" Content="+ Nagłówek" Margin="0,0,5,5" Click="OnAddHeadingBlock" />
                                                <Button Classes="AddCellButton" Content="+ Lista" Margin="0,0,5,5" Click="OnAddListBlock" />
                                                <Button Classes="AddCellButton" Content="+ Zadanie" Margin="0,0,5,5" Click="OnAddChecklistBlock" />
                                                <Button Classes="AddCellButton" Content="+ Kod" Margin="0,0,5,5" Click="OnAddCodeBlock" />
                                                <Button Classes="AddCellButton" Content="+ Tabela" Margin="0,0,5,5" Click="OnAddTableBlock" />
                                                <Button Classes="AddCellButton" Content="+ Obraz" Margin="0,0,5,5" Click="OnInsertImage" />
                                            </WrapPanel>
                                            <TextBlock Text="Każda komórka jest częścią tej samej notatki i zapisuje się automatycznie w jednym pliku."
                                                       Classes="metadata"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Border x:Name="PreviewHost"
                                    Grid.Row="1"
                                    IsVisible="False"
                                    Background="Transparent">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="PreviewContent" Spacing="7" />
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Border>

                <Border x:Name="MetadataPanel"
                        Grid.Column="1"
                        Width="300"
                        Padding="18"
                        BorderThickness="1,0,0,0"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        Background="{DynamicResource SurfaceMutedBrush}">
                    <ScrollViewer>
                        <StackPanel Spacing="9">
                            <TextBlock Text="Szczegóły" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Classes="MetaLabel" Text="TAGI I PROJEKTY" Margin="0,10,0,0" />
                            <TextBox x:Name="NoteTagsBox"
                                     PlaceholderText="projekt-a, klient-x"
                                     TextChanged="OnNoteChanged" />
                            <TextBlock Text="Tag projektu łączy notatkę z jego widokiem i grafem."
                                       FontSize="11"
                                       Opacity="0.55"
                                       TextWrapping="Wrap" />

                            <TextBlock Classes="MetaLabel" Text="OSOBY" Margin="0,10,0,0" />
                            <Button x:Name="NotePeopleButton"
                                    Content="Wybierz osoby…"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="OnNotePeopleClick" />
                            <TextBlock Text="Możesz wybrać kilka osób. Przypisania zasilają panel Osoby i nie mieszają się ze zwykłymi tagami."
                                       FontSize="11"
                                       Opacity="0.55"
                                       TextWrapping="Wrap" />

                            <TextBlock Classes="MetaLabel" Text="SPIS TREŚCI" Margin="0,10,0,0" />
                            <ListBox x:Name="OutlineList"
                                     MaxHeight="180"
                                     SelectionChanged="OnOutlineSelectionChanged" />
                            <TextBlock Text="Nagłówki tworzą nawigację po dokumencie."
                                       FontSize="11"
                                       Opacity="0.55"
                                       TextWrapping="Wrap" />

                            <TextBlock Classes="MetaLabel" Text="POWIĄZANIA W TREŚCI" Margin="0,10,0,0" />
                            <ListBox x:Name="WikiLinksList"
                                     MinHeight="52"
                                     MaxHeight="140"
                                     DoubleTapped="OnWikiLinkDoubleTapped" />
                            <TextBlock Text="Kliknij dwukrotnie, aby otworzyć powiązaną notatkę."
                                       FontSize="11"
                                       Opacity="0.55"
                                       TextWrapping="Wrap" />

                            <TextBlock Classes="MetaLabel" Text="JAWNE RELACJE" Margin="0,10,0,0" />
                            <ListBox x:Name="ExplicitRelationsList"
                                     MinHeight="42"
                                     MaxHeight="140"
                                     DoubleTapped="OnExplicitRelationDoubleTapped" />
                            <TextBlock Text="Relacje utworzone uchwytem na grafie nie zmieniają treści dokumentu."
                                       FontSize="11"
                                       Opacity="0.55"
                                       TextWrapping="Wrap" />

                            <TextBlock Classes="MetaLabel" Text="DATY" Margin="0,10,0,0" />
                            <TextBlock x:Name="NoteDatesText"
                                       Opacity="0.68"
                                       TextWrapping="Wrap"
                                       FontSize="12" />

                            <TextBlock Text="Zadania notatki" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,0" />
                            <TextBlock Text="Zadania poniżej są indeksowane w głównym widoku zadań."
                                       FontSize="11"
                                       Opacity="0.55"
                                       TextWrapping="Wrap" />
                            <StackPanel x:Name="NoteChecklistHost" Spacing="5" />
                            <Button Content="+ Dodaj zadanie"
                                    Click="OnAddNoteTask"
                                    HorizontalAlignment="Left" />

                            <Border Height="1"
                                    Margin="0,16,0,8"
                                    Background="{DynamicResource BorderSubtleBrush}" />
                            <Button Content="Przenieś notatkę do kosza"
                                    Click="OnTrashNote"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="4"
                    Padding="16,6"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderSubtleBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <TextBlock x:Name="DocumentCountText"
                               Grid.Column="0"
                               FontSize="11"
                               Opacity="0.62"
                               Text="0 słów • 0 znaków" />
                    <TextBlock Grid.Column="1"
                               FontSize="11"
                               Opacity="0.5"
                               Text="Komórki dokumentu • jeden przenośny plik • zero internetu"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="EditorSaveStatusText"
                               Grid.Column="2"
                               FontSize="11"
                               Opacity="0.72"
                               Text="Autozapis włączony" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
