<UserControl
    x:Class="MapaNotatek.Views.NoteListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MapaNotatek.Models">
    <ListView
        x:Name="NotesList"
        IsItemClickEnabled="True"
        SelectionMode="Single"
        ItemClick="OnItemClick"
        KeyDown="OnKeyDown">
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="models:Note">
                <StackPanel Padding="8,6">
                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Body}" Opacity="0.7" MaxLines="2" TextWrapping="Wrap" />
                </StackPanel>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</UserControl>
