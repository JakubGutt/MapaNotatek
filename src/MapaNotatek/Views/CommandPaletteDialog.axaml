<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MapaNotatek.Views.CommandPaletteDialog">
    <StackPanel Spacing="8" Width="420">
        <TextBox x:Name="FilterBox" PlaceholderText="Filtruj polecenia…" TextChanged="OnFilterChanged" />
        <ListBox x:Name="CommandsList" MaxHeight="360" DoubleTapped="OnDoubleTapped" />
    </StackPanel>
</UserControl>
