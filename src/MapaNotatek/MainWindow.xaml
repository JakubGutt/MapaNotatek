<Window
    x:Class="MapaNotatek.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MapaNotatek.Views">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0">
            <MenuBarItem Title="Plik" AccessKey="P">
                <MenuFlyoutItem x:Name="NewNoteMenu" Text="Nowa notatka" Click="OnNewNote" AccessKey="N" ToolTipService.ToolTip="Ctrl+N">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="NewProjectMenu" Text="Nowy projekt" Click="OnNewProject" AccessKey="R" ToolTipService.ToolTip="Ctrl+Shift+N">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Zapisz" Click="OnSave" AccessKey="S" ToolTipService.ToolTip="Ctrl+S">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Eksportuj kopię…" Click="OnExportBackup" AccessKey="E" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Ustawienia" Click="OnSettings" KeyboardAcceleratorTextOverride="Ctrl+," AccessKey="U" />
                <MenuFlyoutItem Text="Zamknij panel" Click="OnCloseEditor" KeyboardAcceleratorTextOverride="Ctrl+W" />
            </MenuBarItem>
            <MenuBarItem Title="Edycja" AccessKey="E">
                <MenuFlyoutItem Text="Cofnij" Click="OnUndo" KeyboardAcceleratorTextOverride="Ctrl+Z" AccessKey="C" />
                <MenuFlyoutItem Text="Ponów" Click="OnRedo" KeyboardAcceleratorTextOverride="Ctrl+Y" AccessKey="P" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Szukaj" Click="OnFocusSearch" AccessKey="S" ToolTipService.ToolTip="Ctrl+F">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Zmień nazwę" Click="OnRename" KeyboardAcceleratorTextOverride="F2" />
                <MenuFlyoutItem Text="Przenieś notatkę do kosza" Click="OnTrashNote" KeyboardAcceleratorTextOverride="Delete" />
            </MenuBarItem>
            <MenuBarItem Title="Widok" AccessKey="W">
                <MenuFlyoutItem Text="Graf" Click="OnGraphView" AccessKey="G" ToolTipService.ToolTip="Ctrl+1">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Number1" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Lista notatek" Click="OnNotesView" ToolTipService.ToolTip="Ctrl+2">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Number2" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Otwarte zadania" Click="OnTasksView" ToolTipService.ToolTip="Ctrl+3">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Number3" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Pokaż wszystkie projekty" Click="OnShowAll" />
                <MenuFlyoutItem Text="Pokaż zarchiwizowane" Click="OnToggleArchived" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Powiększ" Click="OnZoomIn" KeyboardAcceleratorTextOverride="Ctrl++" />
                <MenuFlyoutItem Text="Pomniejsz" Click="OnZoomOut" KeyboardAcceleratorTextOverride="Ctrl+-" />
                <MenuFlyoutItem Text="Domyślne powiększenie" Click="OnZoomReset" KeyboardAcceleratorTextOverride="Ctrl+0" />
            </MenuBarItem>
            <MenuBarItem Title="Projekt" AccessKey="R">
                <MenuFlyoutItem Text="Nowy projekt" Click="OnNewProject" KeyboardAcceleratorTextOverride="Ctrl+Shift+N" />
                <MenuFlyoutItem Text="Archiwizuj / przywróć" Click="OnArchiveProject" />
                <MenuFlyoutItem Text="Pokaż wszystkie projekty" Click="OnShowAll" />
            </MenuBarItem>
            <MenuBarItem Title="Pomoc" AccessKey="O">
                <MenuFlyoutItem Text="Lista poleceń" Click="OnCommandPalette" KeyboardAcceleratorTextOverride="Ctrl+Shift+P" />
                <MenuFlyoutItem Text="Skróty klawiszowe" Click="OnShortcuts" KeyboardAcceleratorTextOverride="Ctrl+/" />
            </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="1" ColumnSpacing="8" Padding="8,4,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="260" MinWidth="200" />
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition x:Name="RightColumn" Width="360" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="LeftPanel" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox
                    x:Name="SearchBox"
                    Grid.Row="0"
                    Header="Szukaj"
                    PlaceholderText="Tytuł, treść, tag, projekt"
                    TextChanged="OnSearchChanged" />
                <StackPanel Grid.Row="1" Margin="0,8,0,8" Spacing="6">
                    <Button
                        Content="Nowy projekt"
                        HorizontalAlignment="Stretch"
                        Click="OnNewProject"
                        ToolTipService.ToolTip="Ctrl+Shift+N" />
                    <Button
                        Content="Pokaż wszystkie projekty"
                        HorizontalAlignment="Stretch"
                        Click="OnShowAll" />
                    <CheckBox
                        x:Name="ArchivedCheck"
                        Content="Pokaż zarchiwizowane"
                        Click="OnToggleArchived" />
                </StackPanel>
                <ListView
                    x:Name="ProjectsList"
                    Grid.Row="2"
                    DisplayMemberPath="Name"
                    IsItemClickEnabled="True"
                    SelectionMode="Single"
                    ItemClick="OnProjectClick"
                    KeyDown="OnProjectsKeyDown" />
                <Button
                    Grid.Row="3"
                    Margin="0,8,0,0"
                    Content="Nowa notatka"
                    HorizontalAlignment="Stretch"
                    Click="OnNewNote"
                    ToolTipService.ToolTip="Ctrl+N" />
            </Grid>

            <Grid x:Name="CenterPanel" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                    <RadioButton x:Name="GraphRadio" Content="Graf" GroupName="CenterView" IsChecked="True" Click="OnGraphView" ToolTipService.ToolTip="Ctrl+1" />
                    <RadioButton x:Name="NotesRadio" Content="Notatki" GroupName="CenterView" Click="OnNotesView" ToolTipService.ToolTip="Ctrl+2" />
                    <RadioButton x:Name="TasksRadio" Content="Zadania" GroupName="CenterView" Click="OnTasksView" ToolTipService.ToolTip="Ctrl+3" />
                </StackPanel>
                <views:GraphView x:Name="GraphControl" Grid.Row="1" />
                <views:NoteListView x:Name="NotesControl" Grid.Row="1" Visibility="Collapsed" />
                <views:TaskListView x:Name="TasksControl" Grid.Row="1" Visibility="Collapsed" />
            </Grid>

            <Border x:Name="RightPanel" Grid.Column="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <views:EditorPanel x:Name="EditorControl" />
            </Border>
        </Grid>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="2"
            Margin="12,4"
            Opacity="0.7" />
    </Grid>
</Window>
